{
  "/api": {
    "target": "http://localhost:9090",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true,
    "pathRewrite": {
      "^/api": ""
    }
  }
  ,
  "/auth": {
    "target": "http://localhost:9090",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true,
    "pathRewrite": {
      "^/auth": "/auth"
    }
  },
  "/css": {
    "target": "http://localhost:9090",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true
  },
  "/images": {
    "target": "http://localhost:9090",
    "secure": false,
    "logLevel": "debug",
    "changeOrigin": true
  },
  "/geocode": {
    "target": "https://nominatim.openstreetmap.org",
    "secure": true,
    "logLevel": "debug",
