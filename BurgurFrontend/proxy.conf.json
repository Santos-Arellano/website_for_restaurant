      "User-Agent": "BurgerClubFrontend/1.0 (admin@burgerclub.local)",
      "Accept-Language": "es"
    },
    "pathRewrite": {
      "^/geocode": ""
    }
  },
  "/osm": {
    "target": "https://tile.openstreetmap.org",
